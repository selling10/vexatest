# SMTP för kontaktformuläret (info@vexa.se via Websupport)
# Kopiera till .env och fyll i lösenordet. Committa aldrig .env.
SMTP_HOST=smtp.websupport.se
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@vexa.se
SMTP_PASS=
SMTP_FROM=info@vexa.se
SMTP_TO=info@vexa.se

# Vercel: api/send-email.ts körs i region arn1 (Stockholm) — Websupport
# accepterar inte SMTP-inloggning från utländska datacenter-IP:er.
